{
  "resourceType": "clusters",
  "apiVersion": "2026-07-01-preview",
  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.relay"
  },
  "commands": [
    {
      "name": "Get-AzRelayCluster",
      "description": "Gets a Relay cluster.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Relay/clusters/{clusterName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.relay/get-azrelaycluster"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets a Relay cluster.",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
    {
      "name": "Remove-AzRelayCluster",
      "description": "Deletes a Relay cluster.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Relay/clusters/{clusterName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.relay/remove-azrelaycluster"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Deletes a Relay cluster.",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    }
  ]
}
