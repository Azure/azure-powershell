        },
        "parameterSets": [
          {
            "parameters": [
              "-HealthModelName <String>",
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
