          "description": "Delete a DiscoveryRule",
          "parameters": [
            {
              "name": "-HealthModelName",
              "value": "[Path.healthModelName]"
            },
            {
              "name": "-Name",
              "value": "[Path.discoveryRuleName]"
            },
            {
