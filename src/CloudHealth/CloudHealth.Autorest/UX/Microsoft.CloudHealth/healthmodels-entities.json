      "name": "Get-AzMonitorHealthModelEntitySignalRecommendation",
      "description": "Get recommended signal configurations for a given Entity (only applicable for Entities representing Azure resources)",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.CloudHealth/healthmodels/{healthModelName}/entities/{entityName}/getSignalRecommendations",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.cloudhealth/get-azmonitorhealthmodelentitysignalrecommendation"
        },
        "parameterSets": [
          {
            "parameters": [
              "-EntityName <String>",
              "-HealthModelName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Get recommended signal configurations for a given Entity (only applicable for Entities representing Azure resources)",
          "parameters": [
            {
              "name": "-EntityName",
              "value": "[Path.entityName]"
            },
            {
              "name": "-HealthModelName",
              "value": "[Path.healthModelName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
