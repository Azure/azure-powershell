{
  "resourceType": "mongoClusters",
  "apiVersion": "2026-06-01",
  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.documentdb"
  },
  "commands": [
    {
      "name": "Get-AzDocumentDBMongoCluster",
      "description": "Gets information about a mongo cluster.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.DocumentDB/mongoClusters/{mongoClusterName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.documentdb/get-azdocumentdbmongocluster"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets information about a mongo cluster.",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.mongoClusterName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
    {
      "name": "Remove-AzDocumentDBMongoCluster",
      "description": "Deletes a mongo cluster.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.DocumentDB/mongoClusters/{mongoClusterName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.documentdb/remove-azdocumentdbmongocluster"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Deletes a mongo cluster.",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.mongoClusterName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    }
  ]
}
