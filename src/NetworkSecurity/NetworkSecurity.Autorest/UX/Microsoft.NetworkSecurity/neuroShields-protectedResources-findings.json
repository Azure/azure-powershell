  "commands": [
    {
      "name": "Get-AzNetworkSecurityNeuroShieldFinding",
      "description": "Gets a finding under a protected resource.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.NetworkSecurity/neuroShields/{neuroShieldName}/protectedResources/{protectedResourceName}/findings/{findingId}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.networksecurity/get-aznetworksecurityneuroshieldfinding"
        },
        "parameterSets": [
          {
            "parameters": [
              "-FindingId <String>",
              "-NeuroShieldName <String>",
              "-ProtectedResourceName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets a finding under a protected resource.",
          "parameters": [
            {
              "name": "-FindingId",
              "value": "[Path.findingId]"
            },
            {
              "name": "-NeuroShieldName",
              "value": "[Path.neuroShieldName]"
            },
            {
              "name": "-ProtectedResourceName",
              "value": "[Path.protectedResourceName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
