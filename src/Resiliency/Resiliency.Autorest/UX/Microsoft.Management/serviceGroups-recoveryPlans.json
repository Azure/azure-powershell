{
  "resourceType": "serviceGroups/recoveryPlans",
  "apiVersion": "2026-10-01",
  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.resiliency"
  },
  "commands": [
    {
      "name": "Get-AzResiliencyRecoveryPlan",
      "description": "Get a RecoveryPlan",
      "path": "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/recoveryPlans/{recoveryPlanName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.resiliency/get-azresiliencyrecoveryplan"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ServiceGroupName <String>"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Get a RecoveryPlan",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.recoveryPlanName]"
            },
            {
              "name": "-ServiceGroupName",
              "value": "[Path.serviceGroupName]"
            }
          ]
        }
      ]
    },
    {
      "name": "Invoke-AzResiliencyRecoveryPlanFinalize",
      "description": "This action finalizes the recovery orchestration plan, ensuring all necessary configurations are in place.",
      "path": "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/recoveryPlans/{recoveryPlanName}/finalize",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.resiliency/invoke-azresiliencyrecoveryplanfinalize"
        },
        "parameterSets": [
          {
            "parameters": [
              "-OperationId <String>",
              "-RecoveryPlanName <String>",
              "-ServiceGroupName <String>"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "This action finalizes the recovery orchestration plan, ensuring all necessary configurations are in place.",
          "parameters": [
            {
              "name": "-OperationId",
              "value": "(New-Guid).Guid"
            },
            {
              "name": "-RecoveryPlanName",
              "value": "[Path.recoveryPlanName]"
            },
            {
              "name": "-ServiceGroupName",
              "value": "[Path.serviceGroupName]"
            }
          ]
        }
      ]
    },
    {
      "name": "Remove-AzResiliencyRecoveryPlan",
      "description": "Delete a RecoveryPlan",
      "path": "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/recoveryPlans/{recoveryPlanName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.resiliency/remove-azresiliencyrecoveryplan"
        },
        "parameterSets": [
          {
            "parameters": [
              "-Name <String>",
              "-ServiceGroupName <String>"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Delete a RecoveryPlan",
          "parameters": [
            {
              "name": "-Name",
              "value": "[Path.recoveryPlanName]"
            },
            {
              "name": "-ServiceGroupName",
              "value": "[Path.serviceGroupName]"
            }
          ]
        }
      ]
    },
    {
      "name": "Test-AzResiliencyRecoveryPlanReadiness",
      "description": "This action performs the necessary readiness check on the recovery orchestration plan to ensure it is in the desired state and eligible for all recovery actions, including all protected resources.",
      "path": "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/recoveryPlans/{recoveryPlanName}/checkReadiness",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.resiliency/test-azresiliencyrecoveryplanreadiness"
        },
        "parameterSets": [
          {
            "parameters": [
              "-OperationId <String>",
              "-RecoveryPlanName <String>",
              "-ServiceGroupName <String>"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "This action performs the necessary readiness check on the recovery orchestration plan to ensure it is in the desired state and eligible for all recovery actions, including all protected resources.",
          "parameters": [
            {
              "name": "-OperationId",
              "value": "(New-Guid).Guid"
            },
            {
              "name": "-RecoveryPlanName",
              "value": "[Path.recoveryPlanName]"
            },
            {
              "name": "-ServiceGroupName",
              "value": "[Path.serviceGroupName]"
            }
          ]
        }
      ]
    }
  ]
}
