{
  "resourceType": "clusters/logFiles",
  "apiVersion": "2026-10-01-preview",
  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.horizondb"
  },
  "commands": [
    {
      "name": "Get-AzHorizonDbLogFile",
      "description": "Gets metadata for a captured HorizonDB log file.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/logFiles/{logFileName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/get-azhorizondblogfile"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets metadata for a captured HorizonDB log file.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-Name",
              "value": "[Path.logFileName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    }
  ]
}
