{
  "resourceType": "clusters/pools/maintenanceEvents",
  "apiVersion": "2026-10-01-preview",
  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.horizondb"
  },
  "commands": [
    {
      "name": "Add-AzHorizonDbMaintenanceEventNow",
      "description": "Applies the maintenance event immediately.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/pools/{poolName}/maintenanceEvents/{maintenanceEventId}/applyNow",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/add-azhorizondbmaintenanceeventnow"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-MaintenanceEventId <String>",
              "-PoolName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Applies the maintenance event immediately.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-MaintenanceEventId",
              "value": "[Path.maintenanceEventId]"
            },
            {
              "name": "-PoolName",
              "value": "[Path.poolName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
    {
      "name": "Get-AzHorizonDbMaintenanceEvent",
      "description": "Gets information about a maintenance event for a HorizonDB pool.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/pools/{poolName}/maintenanceEvents/{maintenanceEventId}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/get-azhorizondbmaintenanceevent"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-Id <String>",
              "-PoolName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets information about a maintenance event for a HorizonDB pool.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-Id",
              "value": "[Path.maintenanceEventId]"
            },
            {
              "name": "-PoolName",
              "value": "[Path.poolName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    }
  ]
}
