              "-ObjectId <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets information about a PostgreSQL role that is a member of azure_pg_admin and mapped to a Microsoft Entra principal.",
          "parameters": [
            {
