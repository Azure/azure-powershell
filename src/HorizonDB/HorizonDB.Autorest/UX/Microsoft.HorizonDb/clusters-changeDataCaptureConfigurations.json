  "learnMore": {
    "url": "https://learn.microsoft.com/powershell/module/az.horizondb"
  },
  "commands": [
    {
      "name": "Get-AzHorizonDbChangeDataCaptureConfiguration",
      "description": "Gets a change data capture configuration.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/changeDataCaptureConfigurations/{configurationName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/get-azhorizondbchangedatacaptureconfiguration"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-ConfigurationName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets a change data capture configuration.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-ConfigurationName",
              "value": "[Path.configurationName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
    {
      "name": "Remove-AzHorizonDbChangeDataCaptureConfiguration",
      "description": "Deletes a change data capture configuration after destination-side replication has been stopped or detached.\nThis operation never deletes the Microsoft Fabric mirrored-database item.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/changeDataCaptureConfigurations/{configurationName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/remove-azhorizondbchangedatacaptureconfiguration"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-ConfigurationName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Deletes a change data capture configuration after destination-side replication has been stopped or detached. This operation never deletes the Microsoft Fabric mirrored-database item.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-ConfigurationName",
              "value": "[Path.configurationName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
