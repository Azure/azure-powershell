  },
  "commands": [
    {
      "name": "Get-AzHorizonDbFirewallRule",
      "description": "Gets information about a HorizonDB pool firewall rule.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/pools/{poolName}/firewallRules/{firewallRuleName}",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.horizondb/get-azhorizondbfirewallrule"
        },
        "parameterSets": [
          {
            "parameters": [
              "-ClusterName <String>",
              "-Name <String>",
              "-PoolName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Gets information about a HorizonDB pool firewall rule.",
          "parameters": [
            {
              "name": "-ClusterName",
              "value": "[Path.clusterName]"
            },
            {
              "name": "-Name",
              "value": "[Path.firewallRuleName]"
            },
            {
              "name": "-PoolName",
              "value": "[Path.poolName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
    {
      "name": "Remove-AzHorizonDbFirewallRule",
      "description": "Deletes a HorizonDB pool firewall rule.",
