<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PsModuleName>ContainerRegistry</PsModuleName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Az.Test.props" />

  <PropertyGroup>
    <RootNamespace>$(LegacyAssemblyPrefix)$(PsModuleName)$(AzTestAssemblySuffix)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContainerRegistry\ContainerRegistry.csproj" />
    <ProjectReference Include="..\..\Accounts\Accounts\Accounts.csproj" />
    <ProjectReference Include="NativeCommand\NativeCommand.Test.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NativeCommand\**\*.cs" />
    <None Update="NativeCommand\Invoke-DockerLogin.ps1" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ModuleArtifactsPath</_Parameter1>
      <_Parameter2>$(RepoArtifacts)$(Configuration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="CopyNativeCommandFixture" AfterTargets="Build">
    <MSBuild Projects="NativeCommand\NativeCommand.Test.csproj" Targets="GetFixtureFiles" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="NativeCommandFixtureFiles" />
    </MSBuild>
    <Copy SourceFiles="@(NativeCommandFixtureFiles)" DestinationFolder="$(OutDir)NativeCommand" />
  </Target>

</Project>
