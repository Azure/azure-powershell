      "name": "Get-AzCommvaultCloudAccountLatestLinkedSaaS",
      "description": "Returns the latest SaaS linked to the cloud account.",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Commvault.ContentStore/cloudAccounts/{cloudAccountName}/latestLinkedSaaS",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.commvault/get-azcommvaultcloudaccountlatestlinkedsaas"
        },
        "parameterSets": [
          {
            "parameters": [
              "-CloudAccountName <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Returns the latest SaaS linked to the cloud account.",
          "parameters": [
            {
              "name": "-CloudAccountName",
              "value": "[Path.cloudAccountName]"
            },
