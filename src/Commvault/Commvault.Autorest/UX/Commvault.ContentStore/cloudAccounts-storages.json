  "commands": [
    {
      "name": "Disable-AzCommvaultStorageComplianceLock",
      "description": "Disable compliance lock on the storage.\nInitiates an out-of-band multi-person authorization (MPA) email approval workflow on the partner side.\nThe storage compliance lock status transitions to 'DisablementPending' immediately; once the MPA approval completes, the status becomes 'Disabled' (observable via the refresh action).",
      "path": "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Commvault.ContentStore/cloudAccounts/{cloudAccountName}/storages/{storageName}/disableComplianceLock",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.commvault/disable-azcommvaultstoragecompliancelock"
        },
        "parameterSets": [
          {
            "parameters": [
              "-CloudAccountName <String>",
              "-ResourceGroupName <String>",
              "-StorageName <String>",
              "[-SubscriptionId <String>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Disable compliance lock on the storage. Initiates an out-of-band multi-person authorization (MPA) email approval workflow on the partner side. The storage compliance lock status transitions to 'DisablementPending' immediately; once the MPA approval completes, the status becomes 'Disabled' (observable via the refresh action).",
          "parameters": [
            {
              "name": "-CloudAccountName",
              "value": "[Path.cloudAccountName]"
            },
            {
              "name": "-ResourceGroupName",
              "value": "[Path.resourceGroupName]"
            },
            {
              "name": "-StorageName",
              "value": "[Path.storageName]"
            },
            {
              "name": "-SubscriptionId",
              "value": "[Path.subscriptionId]"
            }
          ]
        }
      ]
    },
