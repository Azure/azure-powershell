      "description": "Refreshes the goal resources under a goal assignment.\nThis operation scans for new resources under the scope of the assignment.",
      "path": "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/goalAssignments/{goalAssignmentName}/refreshGoalResources",
      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.resilience/sync-azresiliencegoalresource"
        },
        "parameterSets": [
          {
            "parameters": [
              "-GoalAssignmentName <String>",
              "-ServiceGroupName <String>"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Refreshes the goal resources under a goal assignment. This operation scans for new resources under the scope of the assignment.",
          "parameters": [
            {
              "name": "-GoalAssignmentName",
              "value": "[Path.goalAssignmentName]"
            },
            {
              "name": "-ServiceGroupName",
