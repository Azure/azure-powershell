      "help": {
        "learnMore": {
          "url": "https://learn.microsoft.com/powershell/module/az.redhatopenshifthcp/get-azredhatopenshifthcpnodepool"
        },
        "parameterSets": [
          {
            "parameters": [
              "-HcpOpenShiftClusterName <String>",
              "-Name <String>",
              "-ResourceGroupName <String>",
              "[-SubscriptionId <String[]>]"
            ]
          }
        ]
      },
      "examples": [
        {
          "description": "Get a NodePool",
          "parameters": [
            {
              "name": "-HcpOpenShiftClusterName",
