<Project>

  <!--
    C1 customization dependency for Az.RedHatOpenShiftHcp.

    The AutoRest-generated module csproj (RedHatOpenShiftHcp.Autorest/Az.RedHatOpenShiftHcp.csproj)
    is REGENERATED by `autorest`, so a PackageReference added directly there is wiped on every
    regeneration. This Directory.Build.props lives OUTSIDE the AutoRest output folder (it is not
    managed by AutoRest) and is auto-imported by MSBuild, so the reference survives regeneration.

    YamlDotNet is needed by custom/KubeConfigHelper.cs (kubeconfig parse/merge for the custom
    Request-AzRedHatOpenShiftHcpClusterAdminCredential cmdlet). Signed variant + version matched to
    src/Aks/Aks/Aks.csproj (established precedent for YamlDotNet in an Az module).

    Scoped by MSBuildProjectName so it applies ONLY to the Autorest project, not the wrapper
    (RedHatOpenShiftHcp/RedHatOpenShiftHcp.csproj).
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Az.RedHatOpenShiftHcp'">
    <PackageReference Include="YamlDotNet.Signed" Version="5.2.1" />
  </ItemGroup>

</Project>
