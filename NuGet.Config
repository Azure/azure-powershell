<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Do not add any additional feeds if new packages are needed they need to come from the azure-powershell feed of Azure DevOps Artifacts -->
    <add key="local-feed" value="tools/LocalFeed" />
    <add key="azure-powershell" value="https://pkgs.dev.azure.com/azclitools/public/_packaging/azure-powershell/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
